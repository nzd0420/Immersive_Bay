# Copy to scripts/local.env and fill in. local.env is not tracked by git.

# SSH alias of the machine with the GPU, as in ~/.ssh/config
GPU_HOST=my-gpu

# The project folder on that machine: relative to the home directory, or absolute.
# It holds activate.sh (activates a Python environment with torch, gsplat and fused-ssim)
# and gsplat/examples (gsplat's examples folder, for its COLMAP parser).
GPU_DIR=live-splat

# Only if yours are somewhere else (relative to GPU_DIR, or absolute):
# GPU_ACTIVATE=activate.sh
# GSPLAT_EXAMPLES=gsplat/examples

# More scenes for the training server, besides the scans it receives:
# EXTRA_SCENES="garden=/data/garden desk=/data/desk"
